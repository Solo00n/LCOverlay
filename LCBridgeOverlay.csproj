<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Lethal Company РёСЃРїРѕР»СЊР·СѓРµС‚ .NET Standard 2.1 -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>LCBridgeOverlay</AssemblyName>
    <Product>LCBridgeOverlay</Product>
    <Version>1.16.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- РРєРѕРЅРєРё РјРѕРЅСЃС‚СЂРѕРІ/Р»РѕРІСѓС€РµРє вЂ” РІСЃС‚СЂР°РёРІР°СЋС‚СЃСЏ РїСЂСЏРјРѕ РІ DLL -->
  <ItemGroup>
    <!-- В DLL зашиваем только иконки. res/map — это образец слоёв схемы, он
         живёт в конфиге игрока и внутри сборки ему делать нечего. -->
    <EmbeddedResource Include="res/**/*.png" Exclude="res/map/**" />
  </ItemGroup>

  <!-- РЎСЃС‹Р»РєРё РЅР° BepInEx Рё РёРіСЂРѕРІС‹Рµ DLL РёР· NuGet (РєР°Рє Сѓ LCBridge). -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="LethalCompany.GameLibs.Steam" Version="*-*" Publicize="true" PrivateAssets="all" />
  </ItemGroup>

  <!--
    BepInEx выбирает между одинаковыми плагинами по версии из [BepInPlugin], а не
    по дате файла. Разъехавшийся с проектом Plugin.VERSION однажды уже стоил
    вечера: три копии мода заявляли 1.13.2, и грузилась произвольная — свежая
    сборка просто не доезжала до игры. Пусть теперь ломается сборка, а не игра.
  -->
  <Target Name="CheckPluginVersion" BeforeTargets="CoreCompile">
    <Error Condition="!$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/src/Plugin.cs').Contains('VERSION = &quot;$(Version)&quot;'))"
           Text="Plugin.VERSION не совпадает с &lt;Version&gt; ($(Version)) — поправь src/Plugin.cs" />
  </Target>

</Project>

