<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Lethal Company РёСЃРїРѕР»СЊР·СѓРµС‚ .NET Standard 2.1 -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>LCBridgeOverlay</AssemblyName>
    <Product>LCBridgeOverlay</Product>
    <Version>1.13.0</Version>
    <LangVersion>latest</LangVersion>
